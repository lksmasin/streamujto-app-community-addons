{
  "manifest": {
    "id": "internet-archive",
    "name": "Internet Archive (Public Domain)",
    "version": "1.1.0",
    "description": "Legální doplněk pro vyhledávání a přehrávání volných filmů z archivu Internet Archive (Public Domain).",
    "author": "KELP Community",
    "type": "api",
    "capabilities": ["search", "directStream"],
    "homeUrl": "https://archive.org"
  },
  "search": {
    "steps": [
      {
        "action": "http",
        "method": "GET",
        "url": "https://archive.org/advancedsearch.php?q={{query|urlencode}}+AND+mediatype%3Amovies&output=json&rows=50&page={{page}}",
        "responseType": "json",
        "listElement": "response.docs",
        "itemMapping": {
          "title": "title",
          "link": "identifier"
        }
      }
    ]
  },
  "streamUrl": {
    "steps": [
      {
        "action": "http",
        "method": "GET",
        "url": "https://archive.org/metadata/{{identifier}}",
        "responseType": "json"
      },
      {
        "action": "regex",
        "input": "{{_response}}",
        "pattern": "\"name\":\\s*\"([^\"]+\\.mp4)\",\\s*\"source\":\\s*\"original\"",
        "group": 1,
        "output": "video_filename",
        "optional": true
      },
      {
        "action": "regex",
        "input": "{{_response}}",
        "pattern": "\"name\":\\s*\"([^/\"]+\\.mp4)\"",
        "group": 1,
        "output": "video_filename",
        "optional": true
      }
    ],
    "result": "https://archive.org/download/{{identifier}}/{{video_filename|urlencode}}"
  }
}
